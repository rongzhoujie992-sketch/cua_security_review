digraph Integrated {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.5"];
  node [shape=box, style="rounded", fontname="Arial", fontsize=10, margin="0.14,0.10"];
  edge [fontname="Arial", fontsize=9];

  subgraph cluster_main {
    label="Main systematic CUA search";
    fontsize=12;
    M0 [label="Records identified\nn = 18,371"];
    M1 [label="Duplicate occurrences removed\nn = 8,281"];
    M2 [label="Records after global deduplication\nn = 10,090"];
    M3 [label="Records screened\nn = 10,087"];
    X0 [label="Other pre-screening removals\nn = 3"];
    M4 [label="Retained report records\nn = 466"];
    X1 [label="Screening exclusions\nn = 9,621"];
    M5 [label="Alternate report versions consolidated\nn = 87"];
    M6 [label="Reports sought for retrieval\nn = 379"];
    X2 [label="Reports not retrieved\nn = 1"];
    M7 [label="Reports assessed for eligibility\nn = 378"];
    X3 [label="Full-text stage removals\nn = 93"];
    M8 [label="Studies entering final review\nn = 285"];
    X4 [label="Final review exclusions\nn = 63"];
    M9 [label="Main CUA corpus\nn = 222 studies", penwidth=2];
    M0 -> M1 -> M2 -> M3 -> M4 -> M5 -> M6 -> M7 -> M8 -> M9;
    M2 -> X0;
    M3 -> X1;
    M6 -> X2;
    M7 -> X3;
    M8 -> X4;
  }

  F [label="Foundational route\nn = 12 sources", penwidth=2];

  subgraph cluster_tdes {
    label="TDES deployment-evidence route";
    fontsize=12;
    T0 [label="TDES supplementary branch\nn = 9 sources"];
    TA [label="Academic sources\nn = 4"];
    TO [label="Official deployment documents\nn = 5"];
    TM [shape=point, width=0.05, label=""];
    T0 -> TA;
    T0 -> TO;
    TA -> TM;
    TO -> TM;
  }

  Z [label="Final evidence source base\nn = 243 sources\n222 + 12 + 4 + 5 = 243", penwidth=2];
  M9 -> Z;
  F -> Z;
  TM -> Z;
}
